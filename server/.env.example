# ─── Server Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/quick_tweets?schema=public"

# JWT — access-token secret (min 16 chars) and lifetime
JWT_SECRET="your-secret-key-here-min-16-chars"
JWT_EXPIRES_IN="15m"

# CORS — allowed frontend origin
CORS_ORIGIN="http://localhost:5173"

# ─── Media (uploads + reclamation) ────────────────────────────────────────────
# Where the local-disk storage backend keeps uploaded bytes.
UPLOAD_DIR="./uploads"

# Media reclamation (M11). `report` is the FAIL-SAFE default: physical deletion
# runs ONLY when this is EXACTLY "destructive"; a missing, empty, mis-cased, or
# misspelled value stays `report`. Leave as report unless the destructive gate
# has been met and reviewed (see issue #354).
MEDIA_RECLAMATION_MODE="report"
# Grace before an owned, unreferenced object may be reclaimed (ms; default 24h).
RECLAMATION_GRACE_MS=86400000
# How often the reclamation pass runs (ms; default 6h).
RECLAMATION_INTERVAL_MS=21600000
# Max objects examined per pass — the single-recovery-unit batch bound (default 100).
RECLAMATION_BATCH=100

# ─── Mail (outbound delivery) ─────────────────────────────────────────────────
# `inert` is the FAIL-SAFE default: the message is logged and discarded, never
# sent, and no credentials are required. An unrecognised value warns and stays
# inert rather than crashing startup.
MAIL_MODE="inert"

# ─── Channel verification ─────────────────────────────────────────────────────
# The challenge code. Crockford base32 (no I/L/O/U) because the code is typed by
# hand; 12 characters over 32 symbols is 60 bits, which keeps a fast digest out
# of offline brute-force range.
CHANNEL_VERIFICATION_CODE_ALPHABET="0123456789ABCDEFGHJKMNPQRSTVWXYZ"
CHANNEL_VERIFICATION_CODE_LENGTH=12
# How long a challenge stays usable (ms; default 15m). It covers received-then-
# typed, not worst-case delivery — an undelivered code is resent, not waited for.
CHANNEL_VERIFICATION_CHALLENGE_TTL_MS=900000
# Minimum gap between challenges for one endpoint (ms; default 60s). The durable
# abuse control; the per-IP limiter is only the outer layer.
CHANNEL_VERIFICATION_RESEND_COOLDOWN_MS=60000
# How often spent challenges are swept (ms; default 6h). Hygiene only — status is
# derived, so no answer the system gives depends on this having run.
CHANNEL_VERIFICATION_SWEEP_INTERVAL_MS=21600000
# How long a spent challenge is kept before removal (ms; default 7d). Diagnostics
# only: the proof lives on the record and is never swept. MUST be positive — a
# negative value would move the cutoff into the future, where the sweep would
# start matching live challenges. Startup rejects anything else.
CHANNEL_VERIFICATION_CHALLENGE_RETENTION_MS=604800000
