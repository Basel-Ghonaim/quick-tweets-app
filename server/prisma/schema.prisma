// ─── Prisma Schema — Quick Tweets Database ──────────────────────────────────
//
// Models:
// - User: Authentication + profile data
// - RefreshToken: JWT refresh token storage (auth module)
// - Tweet: User posts (280 chars max)
// - Comment: Replies to tweets
// - Like: User-tweet like relationship (unique pair)
// - Follow: User-user follow relationship (social graph)
// - MediaObject: Media registry — storage detail + identity (Media platform module)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  profileImage  String?  @map("profile_image")     // DEPRECATED (always null) — superseded by avatarMediaId; retired with the later author-avatar migration
  // Avatar as a bare numeric Media Reference (MediaObject.id): deliberately NO
  // Prisma relation and NO DB foreign key. MediaObject stays unaware of its
  // referrers (ADR 0005 Decision 9), and Media owns reference integrity and
  // reclamation from its own state — never gated by a feature-table FK (M11).
  // Resolved to the public read token at the API boundary; set only by
  // grant-evidence adoption on the register path (M6 / ADR 0007).
  avatarMediaId Int?     @map("avatar_media_id")
  bio           String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  refreshTokens RefreshToken[]
  tweets        Tweet[]
  comments      Comment[]
  likes         Like[]
  followers     Follow[]       @relation("following")  // people who follow ME
  following     Follow[]       @relation("followers")  // people I follow
  mediaObjects  MediaObject[]  // media uploaded/owned (registry provenance)

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─── Tweet ───────────────────────────────────────────────────────────────────

model Tweet {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  media    TweetMedia[]

  // Indexes
  @@index([authorId])
  @@map("tweets")
}

// ─── TweetMedia ──────────────────────────────────────────────────────────────
// The tweets-domain association to media (ADR 0005 Decision 9 — fit the model
// to cardinality): a tweet carries an *ordered* collection of references, so
// the association is its own table rather than a scalar on Tweet.
//
// `mediaId` is a bare numeric Media Reference (MediaObject.id) with NO Prisma
// relation and NO foreign key — exactly as User.avatarMediaId. MediaObject
// stays unaware of its referrers, and Media owns reference integrity from its
// own state, never gated by a feature-table FK (M11).
//
// onDelete: Restrict on the *tweet* side is deliberate, and not the Cascade its
// sibling associations (comments, likes) use — those are owned data, whereas
// this is a reference to an object another module owns. Cascade would drop
// these rows while the registry still believed the objects were referenced, so
// they would never be reclaimed: a silent, permanent leak. Restrict is inert
// today (no write path exists), and becomes a loud failure the moment M9
// attaches real media — at exactly the point the reference-end coordination
// contract is due. That contract supersedes this posture.

model TweetMedia {
  id        Int      @id @default(autoincrement())
  tweetId   Int      @map("tweet_id")
  mediaId   Int      @map("media_id") // bare Media Reference — no FK by design
  position  Int // ordering key, not a dense index: gaps are harmless
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Restrict)

  // Constraints & Indexes
  // No @@index([mediaId]): the only query it serves is "which tweets reference
  // this object" — the feature-schema scan M11 forbids Media from performing.
  @@unique([tweetId, position]) // no two media share a slot in one tweet
  @@unique([tweetId, mediaId]) // the same object is not attached twice
  @@map("tweet_media")
}

// ─── Comment ─────────────────────────────────────────────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  authorId  Int      @map("author_id")
  tweetId   Int      @map("tweet_id")
  // A single optional media file, held as a bare numeric Media Reference
  // (MediaObject.id): deliberately NO Prisma relation and NO DB foreign key,
  // exactly as User.avatarMediaId. MediaObject stays unaware of its referrers
  // (ADR 0005 Decision 9); Media owns reference integrity from its own registry
  // (M11). Resolved to the public read token at the API boundary; set/cleared by
  // attach-authorized coordination on create/edit (referrer tag `comment:{id}`).
  mediaId   Int?     @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tweet  Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([tweetId])
  @@index([authorId])
  @@map("comments")
}

// ─── Like ────────────────────────────────────────────────────────────────────

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tweetId   Int      @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([userId, tweetId])
  @@index([tweetId])
  @@map("likes")
}

// ─── Follow ──────────────────────────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")     // the person who follows
  followingId Int      @map("following_id")    // the person being followed
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  follower  User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([followerId, followingId])   // can't follow someone twice
  @@index([followerId])                  // "who am I following?" (feed query)
  @@index([followingId])                 // "who follows me?" (follower count)
  @@map("follows")
}

// ─── MediaObject ─────────────────────────────────────────────────────────────
// Media registry (ADR 0005 Decision 3): the single owner of storage detail +
// identity for one stored object. Feature tables persist a reference to `id`
// (added by their own Work Items); the opaque `token` is the external read
// handle (GET /media/:token). No back-relation to referrers — a MediaObject is
// unaware of who points at it (Decision 9). Owned by the Media platform module.
//
// Provenance (ADR 0005 Decision 5 + ADR 0007): every object records its
// uploader — an authenticated user (uploader_id) or, for pre-auth ingest, the
// upload grant that ingested it (grant_id + grant_expires_at, so abandonment
// stays computable from Media's own state). Exactly one form is present at
// creation; adoption (M6) later fills uploader_id for grant-ingested objects.
// onDelete: Restrict — Cascade would drop registry rows while bytes remain
// (the Decision-8 divergence); SetNull would un-record the uploader.

model MediaObject {
  id             Int       @id @default(autoincrement())
  token          String    @unique                          // opaque, non-enumerable public read handle
  storageKey     String    @unique @map("storage_key")      // backend location; internal to Media
  contentType    String    @map("content_type")             // verified, content-derived type (set at ingest)
  size           Int                                         // byte count
  status         String    @default("ready")                // "ready" | "deleted" (tombstone; M11 drives deletion)
  uploaderId     Int?      @map("uploader_id")              // authenticated uploader / adopted owner
  grantId        String?   @map("grant_id")                 // pre-auth: the minting upload grant
  grantExpiresAt DateTime? @map("grant_expires_at")         // pre-auth: grant liveness anchor
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  uploader   User?            @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  references MediaReference[]

  // Constraints & Indexes
  // @@unique on grantId is the atomic backstop for GRANT_MAX_OBJECTS = 1
  // (Postgres allows unlimited NULLs, so uploader-provenance rows are
  // unaffected); if that bound ever rises, this becomes a plain index.
  @@unique([grantId])
  @@map("media_objects")
}

// ─── MediaReference ──────────────────────────────────────────────────────────
// Media's own record that *something* holds a reference to an object — the
// state Decision 8 requires: "Media determines what is still referenced from
// its own state, never by reaching into feature schemas."
//
// `referrer` is an OPAQUE tag: the feature composes it, Media stores and
// matches it, and Media never parses or interprets it. That is what keeps
// Decision 9's "a MediaObject is unaware of its referrers" intact — Media
// learns *that* a reference exists, never *what* refers to it. The dependency
// direction is untouched: no foreign key points at a feature table, and Media
// still imports no feature module.
//
// Deliberately model-neutral. Whether an object may carry more than one
// reference — a reusable asset versus a disposable one-time upload — is an
// open PRODUCT decision, so this shape forces neither: multiple referrers are
// simply multiple rows, and exclusivity, if ever chosen, becomes a uniqueness
// constraint layered on top rather than a different mechanism. (A boolean
// marker was rejected for exactly this reason: it is silently wrong the moment
// a second referrer exists.)

model MediaReference {
  id        Int      @id @default(autoincrement())
  mediaId   Int      @map("media_id")
  referrer  String // opaque referrer tag — stored, matched, never interpreted
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  // Within Media's own boundary, so a real FK is appropriate — unlike the
  // feature side, which holds a bare reference. Restrict enforces reclamation's
  // invariant at the database: an object still referenced cannot be removed.
  media MediaObject @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  // Constraints & Indexes
  // One referrer holds one reference to one object: makes a repeated "begin"
  // idempotent rather than duplicating, and makes "end" exact.
  @@unique([mediaId, referrer])
  @@map("media_references")
}
