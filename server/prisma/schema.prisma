// ─── Prisma Schema — Quick Tweets Database ──────────────────────────────────
//
// Models:
// - User: Authentication + profile data
// - RefreshToken: JWT refresh token storage (auth module)
// - Tweet: User posts (280 chars max)
// - Comment: Replies to tweets
// - Like: User-tweet like relationship (unique pair)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  profileImage  String?  @map("profile_image")
  bio           String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  refreshTokens RefreshToken[]
  tweets        Tweet[]
  comments      Comment[]
  likes         Like[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─── Tweet ───────────────────────────────────────────────────────────────────

model Tweet {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  image     String?
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  // Indexes
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("tweets")
}

// ─── Comment ─────────────────────────────────────────────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  authorId  Int      @map("author_id")
  tweetId   Int      @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tweet  Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([tweetId])
  @@index([authorId])
  @@map("comments")
}

// ─── Like ────────────────────────────────────────────────────────────────────

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tweetId   Int      @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([userId, tweetId])
  @@index([tweetId])
  @@map("likes")
}
