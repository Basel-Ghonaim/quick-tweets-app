# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# API application
apps/api/.env
apps/api/src/generated
# Captured mail — full message bodies, i.e. single-use secrets on disk.
# Deliberately unanchored: the destination resolves against the working
# directory, so anchoring it would hold only when the process starts in server/.
.mail-capture/

# Newman run artefacts. The exported environment holds the pasted reset code
# and the cookie jar holds the position key it was issued against — both are
# live single-use secrets, for the same reason .mail-capture/ is ignored above.
.newman/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*storybook.log
storybook-static
# Local scratch plans stay ignored, but the formal plans home (docs/plans/) is tracked.
plans
!docs/plans/
!docs/plans/**

# Local AI working drafts (never committed or pushed)
.project/

# Media blobs written by the local-disk storage adapter (UPLOAD_DIR) — runtime
# data, never source.
apps/api/uploads/
