// ─── Prisma Schema — Quick Tweets Database ──────────────────────────────────
//
// Models:
// - User: Authentication + profile data
// - RefreshToken: JWT refresh token storage (auth module)
// - Tweet: User posts (280 chars max)
// - Comment: Replies to tweets
// - Like: User-tweet like relationship (unique pair)
// - Follow: User-user follow relationship (social graph)
// - MediaObject: Media registry — storage detail + identity (Media platform module)

generator client {
  provider = "prisma-client"
  // Partial indexes are still a preview feature. The one-open-challenge
  // constraint is security-relevant, so it belongs in the schema: were it only
  // hand-written in a migration, a later `migrate dev` would generate a
  // DROP INDEX for it and silently retire the guarantee.
  previewFeatures = ["partialIndexes"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  // Optional profile data: absent = NULL, never defaulted or derived from
  // username (username is only a read-side presentation fallback). Set/cleared
  // via PATCH /users/me; registration never sets it.
  name          String?
  email         String   @unique
  passwordHash  String   @map("password_hash")
  profileImage  String?  @map("profile_image")     // DEPRECATED (always null) — superseded by avatarMediaId; retired with the later author-avatar migration
  // Avatar as a bare numeric Media Reference (MediaObject.id): deliberately NO
  // Prisma relation and NO DB foreign key. MediaObject stays unaware of its
  // referrers (ADR 0005 Decision 9), and Media owns reference integrity and
  // reclamation from its own state — never gated by a feature-table FK (M11).
  // Resolved to the public read token at the API boundary; set by the
  // authenticated User/Profile surface (PATCH /users/me — ADR 0008).
  avatarMediaId Int?     @map("avatar_media_id")
  bio           String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  refreshTokens RefreshToken[]
  tweets        Tweet[]
  comments      Comment[]
  likes         Like[]
  followers     Follow[]       @relation("following")  // people who follow ME
  following     Follow[]       @relation("followers")  // people I follow
  mediaObjects  MediaObject[]  // media uploaded/owned (registry provenance)
  usernameAliases UsernameAlias[]  // former handles this user released (reserved)
  // Back-relation only: proof of control is stored wholly in channel_verifications,
  // never as a column here (ADR 0009 Decision 6).
  channelVerifications ChannelVerification[]
  passwordResetChallenges PasswordResetChallenge[]
  // Back-relation only: whether this account's registration journey is still
  // open lives wholly in onboarding_journeys, and gates nothing the account
  // may do (ADR 0008 Decision 2, as revised).
  onboardingJourney OnboardingJourney?

  @@map("users")
}

// ─── UsernameAlias ───────────────────────────────────────────────────────────
// A former username a user released via a rename. Retained so old locators
// (GET /users/:username, ?author=, /follows/:username) resolve/redirect to the
// current handle, and reserved so no other account can re-register it (no
// impersonation). A handle is "taken" iff it is a current users.username OR a row
// here — that cross-table uniqueness is enforced by the rename/register checks
// (Postgres cannot express it as one constraint) plus the two @unique columns.
model UsernameAlias {
  id        Int      @id @default(autoincrement())
  username  String   @unique                    // the released handle (lowercase-only)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("username_aliases")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─── PasswordResetChallenge ───────────────────────────────────────────────────
// A momentary authorization to change one password, entirely Auth's own
// (ADR 0016) — no standing record the way Channel Verification has one: the
// resend cooldown anchors on this table's own most recent row per user, so a
// second table for that purpose is not needed.
//
// There is no state column, mirroring ChannelVerificationChallenge: used_at
// IS NULL together with expires_at fully determines usable / expired / spent.
// A row is retained after use, never deleted, so a replay stays distinguishable
// from a code that never existed — deletion is the sweep's job, on age alone.
//
// Looked up by its digest, not by (user, code): the screen that submits the
// code does not re-collect the email, so confirm/apply resolve the account
// FROM the row the code identifies, the reverse of Channel Verification's own
// subject-first lookup. code_hash is therefore unique — collision odds are
// cryptographically negligible, and making it a hard constraint means two rows
// can never coexist for one code rather than leaving that to be merely unlikely.
model PasswordResetChallenge {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Digested at rest, the same reasoning as Channel Verification's own
  // secret_hash: an emailed code is more exposed than an HttpOnly cookie.
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Serves the request flow's cooldown check: the most recent row for a known
  // user, read under the repository's advisory lock rather than a database
  // constraint — there is deliberately no "at most one usable row" index, since
  // a resend never touches the prior row (it is left to expire and be swept).
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_challenges")
}

// ─── OnboardingJourney ───────────────────────────────────────────────────────
// The registration journey a client presents after the account exists: profile,
// then verification. It decides only which screens a reader may reach; nothing
// the account may do is gated on it (ADR 0008 Decision 2, as revised).
//
// There is no phase column. Phase is derived on read from the marks below in a
// fixed order, so a journey is correct with nobody having written to it — the
// property channel_verifications already relies on.
//
// user_id is unique: a journey is created exactly once per account, ever, by
// registration alone. Nothing deletes the row and there is no sweep — one row
// per account is bounded by account count, and the surviving row IS the record
// that this account's journey happened. That is what makes a closed journey
// permanently closed rather than merely absent.
model OnboardingJourney {
  id     Int  @id @default(autoincrement())
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set-once marks, never cleared. Absence is the earlier phase, so each is
  // written only over NULL and the record is monotonic by construction.
  profileSettledAt DateTime? @map("profile_settled_at")
  codeReachedAt    DateTime? @map("code_reached_at")
  closedAt         DateTime? @map("closed_at")
  // Diagnostic only, never read for a decision: "declined" | "verified".
  closedReason     String?   @map("closed_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("onboarding_journeys")
}

// ─── Tweet ───────────────────────────────────────────────────────────────────

model Tweet {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  media    TweetMedia[]

  // Indexes
  @@index([authorId])
  @@map("tweets")
}

// ─── TweetMedia ──────────────────────────────────────────────────────────────
// The tweets-domain association to media (ADR 0005 Decision 9 — fit the model
// to cardinality): a tweet carries an *ordered* collection of references, so
// the association is its own table rather than a scalar on Tweet.
//
// `mediaId` is a bare numeric Media Reference (MediaObject.id) with NO Prisma
// relation and NO foreign key — exactly as User.avatarMediaId. MediaObject
// stays unaware of its referrers, and Media owns reference integrity from its
// own state, never gated by a feature-table FK (M11).
//
// onDelete: Restrict on the *tweet* side is deliberate, and not the Cascade its
// sibling associations (comments, likes) use — those are owned data, whereas
// this is a reference to an object another module owns. Cascade would drop
// these rows while the registry still believed the objects were referenced, so
// they would never be reclaimed: a silent, permanent leak. Restrict is inert
// today (no write path exists), and becomes a loud failure the moment M9
// attaches real media — at exactly the point the reference-end coordination
// contract is due. That contract supersedes this posture.

model TweetMedia {
  id        Int      @id @default(autoincrement())
  tweetId   Int      @map("tweet_id")
  mediaId   Int      @map("media_id") // bare Media Reference — no FK by design
  position  Int // ordering key, not a dense index: gaps are harmless
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Restrict)

  // Constraints & Indexes
  // No @@index([mediaId]): the only query it serves is "which tweets reference
  // this object" — the feature-schema scan M11 forbids Media from performing.
  @@unique([tweetId, position]) // no two media share a slot in one tweet
  @@unique([tweetId, mediaId]) // the same object is not attached twice
  @@map("tweet_media")
}

// ─── Comment ─────────────────────────────────────────────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  authorId  Int      @map("author_id")
  tweetId   Int      @map("tweet_id")
  // A single optional media file, held as a bare numeric Media Reference
  // (MediaObject.id): deliberately NO Prisma relation and NO DB foreign key,
  // exactly as User.avatarMediaId. MediaObject stays unaware of its referrers
  // (ADR 0005 Decision 9); Media owns reference integrity from its own registry
  // (M11). Resolved to the public read token at the API boundary; set/cleared by
  // attach-authorized coordination on create/edit (referrer tag `comment:{id}`).
  mediaId   Int?     @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // onDelete: Restrict — a comment may hold a media reference, and a DB cascade
  // would drop the row while the registry still believed the object referenced,
  // leaking it. Restrict forces tweet deletion through the coordinated
  // application use-case (which ends comment:{id} references and deletes the
  // comments first), turning a silent leak into a loud failure on any bypass.
  // The author (User) relation stays Cascade — the account-deletion path is
  // dormant (no route) and is coordinated separately (its own Issue).
  tweet  Tweet @relation(fields: [tweetId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([tweetId])
  @@index([authorId])
  @@map("comments")
}

// ─── Like ────────────────────────────────────────────────────────────────────

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tweetId   Int      @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([userId, tweetId])
  @@index([tweetId])
  @@map("likes")
}

// ─── Follow ──────────────────────────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")     // the person who follows
  followingId Int      @map("following_id")    // the person being followed
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  follower  User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([followerId, followingId])   // can't follow someone twice
  @@index([followerId])                  // "who am I following?" (feed query)
  @@index([followingId])                 // "who follows me?" (follower count)
  @@map("follows")
}

// ─── MediaObject ─────────────────────────────────────────────────────────────
// Media registry (ADR 0005 Decision 3): the single owner of storage detail +
// identity for one stored object. Feature tables persist a reference to `id`
// (added by their own Work Items); the opaque `token` is the external read
// handle (GET /media/:token). No back-relation to referrers — a MediaObject is
// unaware of who points at it (Decision 9). Owned by the Media platform module.
//
// Provenance (ADR 0005 Decision 5, as amended by ADR 0008): every object records
// its authenticated uploader in `uploader_id` (NOT NULL) — the single ownership
// model after the pre-auth upload grant was retired (WI-6 / WI-7).
// onDelete: Restrict — Cascade would drop registry rows while bytes remain
// (the Decision-8 divergence).

model MediaObject {
  id             Int       @id @default(autoincrement())
  token          String    @unique                          // opaque, non-enumerable public read handle
  storageKey     String    @unique @map("storage_key")      // backend location; internal to Media
  contentType    String    @map("content_type")             // verified, content-derived type (set at ingest)
  size           Int                                         // byte count
  status         String    @default("ready")                // "ready" | "deleted" (tombstone; M11 drives deletion)
  uploaderId     Int       @map("uploader_id")              // the authenticated uploader that owns the object (single provenance model, ADR 0008)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  uploader    User              @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  references  MediaReference[]
  quarantines MediaQuarantine[]

  // Constraints & Indexes
  @@map("media_objects")
}

// ─── MediaReference ──────────────────────────────────────────────────────────
// Media's own record that *something* holds a reference to an object — the
// state Decision 8 requires: "Media determines what is still referenced from
// its own state, never by reaching into feature schemas."
//
// `referrer` is an OPAQUE tag: the feature composes it, Media stores and
// matches it, and Media never parses or interprets it. That is what keeps
// Decision 9's "a MediaObject is unaware of its referrers" intact — Media
// learns *that* a reference exists, never *what* refers to it. The dependency
// direction is untouched: no foreign key points at a feature table, and Media
// still imports no feature module.
//
// Deliberately model-neutral. Whether an object may carry more than one
// reference — a reusable asset versus a disposable one-time upload — is an
// open PRODUCT decision, so this shape forces neither: multiple referrers are
// simply multiple rows, and exclusivity, if ever chosen, becomes a uniqueness
// constraint layered on top rather than a different mechanism. (A boolean
// marker was rejected for exactly this reason: it is silently wrong the moment
// a second referrer exists.)

model MediaReference {
  id        Int      @id @default(autoincrement())
  mediaId   Int      @map("media_id")
  referrer  String // opaque referrer tag — stored, matched, never interpreted
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  // Within Media's own boundary, so a real FK is appropriate — unlike the
  // feature side, which holds a bare reference. Restrict enforces reclamation's
  // invariant at the database: an object still referenced cannot be removed.
  media MediaObject @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  // Constraints & Indexes
  // One referrer holds one reference to one object: makes a repeated "begin"
  // idempotent rather than duplicating, and makes "end" exact.
  @@unique([mediaId, referrer])
  @@map("media_references")
}

// ─── MediaReclamationAudit ───────────────────────────────────────────────────
// The reclamation collector's append-only trail (M11). One row per candidate or
// divergence per pass, written in BOTH modes: report mode records would_reclaim
// / would_quarantine (nothing changed); destructive mode records reclaimed /
// quarantined. This is the durable, queryable evidence a human reviews over the
// report-only soak before the destructive gate is ever opened. Media-owned; no
// foreign key to a feature table.

model MediaReclamationAudit {
  id         Int      @id @default(autoincrement())
  mediaId    Int?     @map("media_id")     // null for orphan-bytes (no registry row)
  storageKey String?  @map("storage_key")  // recorded for orphan-bytes
  reason     String                         // abandoned | unreferenced | row_without_bytes | orphan_bytes
  outcome    String                         // would_reclaim | reclaimed | would_quarantine | quarantined
  bytes      Int      @default(0)
  mode       String                         // report | destructive
  runAt      DateTime @map("run_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([runAt])
  @@map("media_reclamation_audit")
}

// ─── MediaQuarantine ─────────────────────────────────────────────────────────
// A registry↔storage divergence held for human review (ADR 0005 Decision 8,
// invariant 3) — never deleted on divergence alone. A *separate* record, so a
// MediaObject stays immutable-once-ready: quarantine is Media's observation
// *about* an object, not a mutation of it — and it also holds the orphan-bytes
// case, which has no row to stamp. Reclamation selection excludes any object
// with an OPEN (resolved_at IS NULL) quarantine row.

model MediaQuarantine {
  id         Int       @id @default(autoincrement())
  mediaId    Int?      @map("media_id")     // null for orphan-bytes
  storageKey String?   @map("storage_key")
  kind       String                          // row_without_bytes | orphan_bytes
  detail     String    @default("")
  detectedAt DateTime  @map("detected_at")
  resolvedAt DateTime? @map("resolved_at")   // OPEN while null
  createdAt  DateTime  @default(now()) @map("created_at")

  // Within Media's own boundary — a real FK. Nullable for the orphan-bytes case.
  media MediaObject? @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([resolvedAt])
  @@map("media_quarantine")
}

// ─── ChannelVerification ─────────────────────────────────────────────────────
// Proof of control over a communication channel endpoint, owned entirely here:
// `users` stores nothing about it, and the endpoint arrives as a caller-supplied
// subject rather than a join to the mutable users.email (ADR 0009).
//
// Status is derived, never stored: a proof matching the current endpoint is
// Proven, an open unexpired challenge is Pending, anything else Unproven. Expiry
// therefore needs no write to be correct, so a lagging sweep cannot make the
// system answer wrongly.
model ChannelVerification {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The proven value, frozen. Divergence from the account's current endpoint is
  // the signal that the new one is unproven — not drift to reconcile.
  endpoint String
  provenAt DateTime? @map("proven_at")
  // Anchored on the record rather than the challenge, so rotating a challenge
  // cannot reset the resend throttle.
  lastChallengedAt DateTime? @map("last_challenged_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  challenges ChannelVerificationChallenge[]

  // One record per subject: an endpoint can be renamed away and back, so lookup
  // must be deterministic.
  @@unique([userId, endpoint])
  @@map("channel_verifications")
}

// ─── ChannelVerificationChallenge ────────────────────────────────────────────
// An outstanding demonstration, subordinate to the record above — the proof
// outlives any single challenge.
//
// There is no state column: open is the absence of closed_at, which together
// with expires_at fully determines open / expired / closed. closed_reason is
// diagnostic only and is never read for an authorization decision.
model ChannelVerificationChallenge {
  id             Int                 @id @default(autoincrement())
  verificationId Int                 @map("verification_id")
  verification   ChannelVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  // Digested at rest: an emailed secret is more exposed than an HttpOnly cookie.
  secretHash   String    @map("secret_hash")
  expiresAt    DateTime  @map("expires_at")
  closedAt     DateTime? @map("closed_at")
  closedReason String?   @map("closed_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  // At most one open challenge per record: concurrent live secrets widen the
  // attack surface for no user benefit. Partial, because a plain unique would
  // permit unlimited open rows — Postgres treats NULLs as distinct.
  @@unique([verificationId], where: { closedAt: null }, map: "channel_verification_challenges_one_open")
  @@index([expiresAt])
  @@map("channel_verification_challenges")
}

// ─── MailSendAttempt ─────────────────────────────────────────────────────────
// One outbound send attempt, recorded by the mail mechanism for its own abuse
// controls (ADR 0015 Decision 4).
//
// It references no consumer and no consumer's rows. That is the point: deriving
// a security control from a consumer's data would let that consumer's retention
// setting silently weaken it.
//
// Per-event rather than a counter because the window is rolling, and a bucketed
// count could only approximate one. The pruning job is what keeps the rows
// bounded.
model MailSendAttempt {
  id Int @id @default(autoincrement())
  // A digest of the lowercased recipient, never the address. The cap only ever
  // asks whether two attempts share a recipient, so the address is never read
  // back — and this table would otherwise hold every recipient ever mailed.
  recipientKey String @map("recipient_key")
  // Diagnostic only, and never read for a cap decision: every attempt counts
  // regardless of how it turned out. Without it a tripped ceiling cannot be
  // explained after the fact.
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  // The per-recipient window query.
  @@index([recipientKey, createdAt])
  // The global ceiling's window query, and the pruning job's cutoff.
  @@index([createdAt])
  @@map("mail_send_attempts")
}
