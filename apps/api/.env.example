# ─── Server Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/quick_tweets?schema=public"

# JWT — access-token secret (min 16 chars) and lifetime
JWT_SECRET="your-secret-key-here-min-16-chars"
JWT_EXPIRES_IN="15m"

# CORS — allowed frontend origin
CORS_ORIGIN="http://localhost:5173"

# ─── Media (uploads + reclamation) ────────────────────────────────────────────
# Where the local-disk storage backend keeps uploaded bytes.
UPLOAD_DIR="./uploads"

# Media reclamation (M11). `report` is the FAIL-SAFE default: physical deletion
# runs ONLY when this is EXACTLY "destructive"; a missing, empty, mis-cased, or
# misspelled value stays `report`. Leave as report unless the destructive gate
# has been met and reviewed (see issue #354).
MEDIA_RECLAMATION_MODE="report"
# Grace before an owned, unreferenced object may be reclaimed (ms; default 24h).
RECLAMATION_GRACE_MS=86400000
# How often the reclamation pass runs (ms; default 6h).
RECLAMATION_INTERVAL_MS=21600000
# Max objects examined per pass — the single-recovery-unit batch bound (default 100).
RECLAMATION_BATCH=100

# ─── Mail (outbound delivery) ─────────────────────────────────────────────────
# OUTSIDE PRODUCTION `inert` is the FAIL-SAFE default: the message is logged and
# discarded, never sent, and no credentials are required. An unrecognised value
# warns and stays inert rather than crashing startup.
#
# IN PRODUCTION the rule inverts: a mode must be able to deliver or the process
# does not start. `inert` reports success while sending nothing, so a fallback
# there would hide a total outage behind one warning line. An unrecognised value
# refuses too — nothing falls back in production.
#
# `capture` writes the FULL message — including the body — to .mail-capture/,
# which is how manual verification gets an inbox: a code that is discarded on
# delivery and digested at rest is otherwise knowable to nobody. It therefore
# puts single-use secrets on disk, so it is reachable only by this exact value,
# and production refuses it as a consequence of the delivery rule above rather
# than as a special case. Nothing ever falls back TO capture. The destination is
# a convention, not a setting.
#
# `smtp` actually delivers. It requires the settings below, and the server
# refuses to start without them rather than failing at the first send.
MAIL_MODE="inert"

# The SMTP transport. A provider is a host and a credential, so switching one
# changes only these values — never any code. Required only when MAIL_MODE is
# "smtp"; leave them empty otherwise.
#
# SMTP_SECURE="false" selects STARTTLS, which the 587 submission port uses;
# "true" is implicit TLS, normally port 465. Many providers require MAIL_FROM
# to be the authenticated identity and will rewrite or reject anything else.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
# Never a real value here — this file is committed. The secret lives in .env.
SMTP_PASSWORD="your-smtp-password-or-app-password"
MAIL_FROM=""

# Bounds the whole send attempt, so a hung relay cannot hold an HTTP request
# open or delay shutdown.
MAIL_SEND_TIMEOUT_MS=10000

# The mail mechanism's own abuse controls, over a rolling window.
#
# The recipient cap stops one inbox being flooded and is enforced exactly.
# The ceiling protects spend and sender reputation, which are measured against
# the sender — so it is keyed on nothing and counts everything. Keep it BELOW
# whatever the provider itself allows, so our breaker trips first and visibly;
# a provider that refuses before we do is a limit we cannot alarm on.
#
# Two named limits, not one: MAIL_RECIPIENT_CAP is the reserved ceiling for
# account recovery; MAIL_RECIPIENT_CAP_GENERAL is what every other consumer is
# admitted under. It must stay strictly below the reserved cap — the server
# refuses to start otherwise — since the gap between the two is the reserve.
MAIL_RECIPIENT_CAP=20
MAIL_RECIPIENT_CAP_GENERAL=15
MAIL_RECIPIENT_CAP_WINDOW_MS=86400000
MAIL_OUTBOUND_CEILING=200
MAIL_OUTBOUND_CEILING_WINDOW_MS=86400000

# Sweeping spent attempts. Hygiene only: an attempt that has aged out of every
# window is already irrelevant whether or not anything removed it.
#
# Retention may NEVER be shorter than the longest window above. If it were, the
# sweep would delete rows a window still counts and the caps would quietly
# under-enforce, with nothing anywhere reporting it. The server refuses to start
# rather than allow that.
MAIL_ATTEMPT_SWEEP_INTERVAL_MS=21600000
MAIL_ATTEMPT_RETENTION_MS=604800000

# ─── Channel verification ─────────────────────────────────────────────────────
# The challenge code. Crockford base32 (no I/L/O/U) because the code is typed by
# hand; 12 characters over 32 symbols is 60 bits, which keeps a fast digest out
# of offline brute-force range.
CHANNEL_VERIFICATION_CODE_ALPHABET="0123456789ABCDEFGHJKMNPQRSTVWXYZ"
CHANNEL_VERIFICATION_CODE_LENGTH=12
# How long a challenge stays usable (ms; default 15m). It covers received-then-
# typed, not worst-case delivery — an undelivered code is resent, not waited for.
CHANNEL_VERIFICATION_CHALLENGE_TTL_MS=900000
# Minimum gap between challenges for one endpoint (ms; default 60s). The durable
# abuse control; the per-IP limiter is only the outer layer.
CHANNEL_VERIFICATION_RESEND_COOLDOWN_MS=60000
# How often spent challenges are swept (ms; default 6h). Hygiene only — status is
# derived, so no answer the system gives depends on this having run.
CHANNEL_VERIFICATION_SWEEP_INTERVAL_MS=21600000
# How long a spent challenge is kept before removal (ms; default 7d). Diagnostics
# only: the proof lives on the record and is never swept. MUST be positive — a
# negative value would move the cutoff into the future, where the sweep would
# start matching live challenges. Startup rejects anything else.
CHANNEL_VERIFICATION_CHALLENGE_RETENTION_MS=604800000
